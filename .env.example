# AI generation providers
# Groq (primary): https://console.groq.com
GROQ_API_KEY=
# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=
# NVIDIA NIM / build.nvidia.com (automatic fallback)
NVIDIA_API_KEY=
# Optional: override the NVIDIA model. Default 'meta/llama-3.3-70b-instruct'
# is now EOL; set one that your NVIDIA account can access (e.g. via
# https://integrate.api.nvidia.com/v1/models).
# NVIDIA_MODEL=

# Etsy Open API v3
ETSY_API_KEY=
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
# OAuth 2.0 Bearer access token (from scripts/etsy_auth_setup.py)
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_TOKEN_EXPIRES_AT=

# Optional notifications for scheduler.py (Telegram or Discord):  # noqa: E501
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
